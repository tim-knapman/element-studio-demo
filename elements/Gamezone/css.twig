%%SELECTOR%% {
padding:0 2rem;
width:100%  
}





/* Header Styles */
%%SELECTOR%% .gamezone__header {
  background-color: #44B63B1A;
    line-height: 1.2;
    padding: 16px;
    border: 1.5px solid #44b63b;
    border-radius: 1px;
    font-style: italic;
    text-transform: uppercase;
    color:#FFF;
    margin-bottom: 0
}

%%SELECTOR%% .gamezone__header.has-icon {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-right:auto
}

%%SELECTOR%% .gamezone__header-icon {
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
}

%%SELECTOR%% .gamezone__title {
    line-height: 1;
    font-size: 35px;
    font-style: italic;
    text-transform: uppercase;
    color:#FFF
}


@media(max-width:1599px){
%%SELECTOR%%{
    max-width: 1170px;
    margin-left:auto;
     margin-right:auto
  }
}

@media(max-width:1279px){
  %%SELECTOR%%{
   max-width:900px;
  }
}

@media(max-width:1199px){
  %%SELECTOR%% .gamezone__title{
  font-size:30px;
  }
}

@media(max-width:767px){
  %%SELECTOR%% .gamezone__title{
  font-size:26px;
  }
}

@media(max-width:479px){
%%SELECTOR%% {
padding:0 15px;
}
}





